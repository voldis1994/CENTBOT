# Copy to config/local.yaml (gitignored) for live operation.
system:
  mode: live  # or dry_run

analysis:
  auto_accept: true  # required for live claims

finance:
  crypto_wallet_public: "0xYOUR_PUBLIC_BASE_USDC_ADDRESS"

platforms:
  basedagents:
    keypair_path: data/basedagents-keypair.json
  bountybook:
    # If api.bountybook.ai is unreachable from your network, set a reachable mirror:
    # base_url: https://your-reachable-host
    enabled: true

# Environment (preferred for secrets):
#   BASEDAGENTS_KEYPAIR_PATH=data/basedagents-keypair.json
#   CENTBOT_ETH_PRIVATE_KEY=0x...          # TaskMarket / BountyBook signing
#   BOUNTYBOOK_API_KEY=...                # Bearer after wallet login
#   CENTBOT_SECRET_KEY=...                # optional Fernet key for credentials.enc
